# Copia este archivo a .env y ajusta los valores (el .env NO se sube a git).

# Conexión a PostgreSQL. Local (docker compose) o la cadena de Neon (con ?sslmode=require).
DATABASE_URL=postgres://siarf:siarf@localhost:5432/siarf

# Secreto para firmar los tokens (mínimo 16 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRA=8h

# Orígenes permitidos por CORS, separados por coma (la URL de Vercel en producción).
CORS_ORIGIN=http://localhost:5173

PORT=3000

# Al arrancar: aplicar migraciones y sembrar datos iniciales (idempotente).
AUTO_MIGRATE=true
AUTO_SEED=true

# Administrador inicial (se crea solo si no existe). Cambia la contraseña.
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=CambiaEstaClave123

# Zona horaria para las métricas por hora.
TZ_NEGOCIO=America/Caracas
